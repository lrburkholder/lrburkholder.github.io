---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Writing">
  <h1>Writing</h1>
  {posts.map(post => <article><h2><a href={`/writing/${post.id}/`}>{post.data.title}</a></h2><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-CA', {year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</time><p>{post.data.description}</p></article>)}
</Base>
