---
const { title = 'public static void async', description = 'Software engineering, agentic development, and lessons learned along the way.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title === 'public static void async' ? title : `${title} | public static void async`}</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <style is:global>
      :root { color-scheme: light dark; font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; line-height: 1.65; }
      body { max-width: 760px; padding: 2rem 1.25rem 4rem; margin: auto; }
      a { color: inherit; text-underline-offset: 3px; }
      header { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; border-bottom: 1px solid #8885; padding-bottom: 1rem; }
      nav { display: flex; gap: 1rem; }
      main { padding-top: 2rem; }
      h1, h2, h3 { line-height: 1.25; }
      h1 { font-size: clamp(2rem, 5vw, 3rem); }
      .muted, time { opacity: .72; }
      article { margin: 2rem 0; }
      footer { margin-top: 4rem; border-top: 1px solid #8885; padding-top: 1rem; font-size: .9rem; }
      pre { overflow-x: auto; padding: 1rem; background: #8882; border-radius: .5rem; }
      img { max-width: 100%; }
    </style>
  </head>
  <body>
    <header><a href="/" style="font-weight:700;text-decoration:none">public static void async</a><nav><a href="/">Home</a><a href="/projects/">Projects</a><a href="/writing/">Writing</a><a href="https://github.com/lrburkholder">GitHub</a></nav></header>
    <main><slot /></main>
    <footer>Written and maintained by Luke Burkholder.</footer>
  </body>
</html>
