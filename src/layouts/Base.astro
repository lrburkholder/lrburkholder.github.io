---
const { title = 'public static void async', description = 'Software engineering, agentic development, and lessons learned along the way.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title === 'public static void async' ? title : `${title} | public static void async`}</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <style is:global>
      :root {
        color-scheme: dark;
        font-family: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: 16px;
        line-height: 1.7;
        background: #1e1e1e;
        color: #d4d4d4;
        --surface: #252526;
        --border: #3c3c3c;
        --muted: #a6a6a6;
        --link: #82c7ff;
        --comment: #8fbd83;
        --mono: 'Cascadia Code', 'Consolas', 'SFMono-Regular', ui-monospace, monospace;
      }
      * { box-sizing: border-box; }
      body { max-width: 880px; min-height: 100vh; padding: 2rem 1.5rem 3rem; margin: auto; }
      a { color: var(--link); text-underline-offset: 3px; }
      a:hover { color: #b9e1ff; }
      a:focus-visible { outline: 2px solid var(--link); outline-offset: 4px; border-radius: 2px; }
      header { display: flex; align-items: baseline; justify-content: space-between; gap: .75rem 1.5rem; flex-wrap: wrap; border-bottom: 1px solid var(--border); padding-bottom: 1.15rem; }
      .site-title { font-family: var(--mono); font-size: .95rem; font-weight: 600; color: #e5e5e5; text-decoration: none; }
      .site-title:hover { color: #fff; }
      nav { display: flex; gap: .55rem 1.2rem; flex-wrap: wrap; font-size: .9rem; }
      nav a { color: #bcbcbc; text-decoration: none; }
      nav a:hover, nav a[aria-current="page"] { color: var(--link); }
      main { padding-top: 2.2rem; }
      h1, h2, h3 { color: #ededed; line-height: 1.3; }
      h1 { font-size: clamp(2rem, 5vw, 2.85rem); letter-spacing: -.025em; margin: 0 0 1.2rem; }
      h2 { font-size: 1.45rem; margin: 2.5rem 0 1rem; }
      h3 { font-size: 1.15rem; margin: 1.6rem 0 .55rem; }
      p { margin: .7rem 0 1.1rem; }
      .section-heading { color: var(--comment); font-family: var(--mono); font-size: 1.05rem; font-weight: 500; letter-spacing: 0; padding-top: .3rem; }
      .section-heading::before { content: '// '; color: #6a9955; }
      .muted, time { color: var(--muted); }
      time { font-family: var(--mono); font-size: .8rem; }
      article { margin: 2rem 0; }
      .project-card { background: var(--surface); border: 1px solid var(--border); border-radius: 7px; padding: 1.15rem 1.35rem; margin: 1rem 0; }
      .project-card h3 { margin: 0 0 .65rem; }
      .project-card p:last-child { margin-bottom: 0; }
      .project-card--planned { background: transparent; }
      .project-links { font-family: var(--mono); font-size: .84rem; }
      .project-links a + a::before { content: ' · '; color: var(--muted); }
      footer { margin-top: 4.5rem; border-top: 1px solid var(--border); padding-top: 1.2rem; font-size: .85rem; color: var(--muted); }
      pre { overflow-x: auto; padding: 1.1rem; background: #181818; border: 1px solid var(--border); border-radius: 6px; line-height: 1.55; }
      code, pre { font-family: var(--mono); }
      :not(pre) > code { background: #303030; padding: .1em .3em; border-radius: 3px; overflow-wrap: anywhere; }
      blockquote { border-left: 3px solid #6a9955; padding-left: 1rem; margin-left: 0; color: #c2c2c2; }
      img { max-width: 100%; height: auto; }
      @media (max-width: 600px) {
        body { padding: 1.25rem 1rem 2rem; }
        main { padding-top: 1.7rem; }
        .project-card { padding: 1rem; }
        nav { gap: .5rem 1rem; }
      }
    </style>
  </head>
  <body>
    <header>
      <a class="site-title" href="/">public static void async</a>
      <nav aria-label="Main navigation">
        <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a>
        <a href="/projects/" aria-current={Astro.url.pathname.startsWith('/projects/') ? 'page' : undefined}>Projects</a>
        <a href="/writing/" aria-current={Astro.url.pathname.startsWith('/writing/') ? 'page' : undefined}>Writing</a>
        <a href="https://github.com/lrburkholder">GitHub</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>Written and maintained by Luke Burkholder.</footer>
  </body>
</html>
